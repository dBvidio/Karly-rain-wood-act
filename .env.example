# Copy this file to .env.local and fill in real values before deploying.

# --- Rep lookup provider ---
# Primary: Geocodio (https://www.geocod.io) — free account, pay-as-you-go beyond
# the free tier. Returns official contact-form URLs for each legislator, which
# is what powers the "open my rep's contact form" fallback. See README.md for
# the tradeoff writeup vs. Cicero / a paid advocacy platform.
GEOCODIO_API_KEY=

# --- Action counter (optional "X people have taken action" display) ---
# Ships with a local JSON-file counter for development. For production on
# Vercel, swap lib/counter.ts to use Vercel KV / Upstash Redis (see README)
# and set these instead:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Analytics (optional) ---
# If set, funnel events are also sent to a Plausible instance.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Self-endorsement form (Endorsements section -> "Endorse This Campaign") ---
# The Web App URL from a Google Apps Script deployment bound to a Google
# Sheet — appends each submission as a row and emails a confirmation to
# StandForKarlyRain@gmail.com. See google-apps-script/endorsements.gs and
# the README section "How the self-endorsement flow works" for setup.
ENDORSEMENT_WEBHOOK_URL=
# Must match the SHARED_SECRET value pasted into endorsements.gs — stops
# anyone who discovers the Web App URL from spamming the sheet/inbox.
ENDORSEMENT_WEBHOOK_SECRET=
